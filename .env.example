# ==============================================================================
# InkLoop Environment Configuration Template
# Copy this file to .env and fill in your authorized credentials.
# NEVER commit your actual .env file to version control.
# ==============================================================================

# Meta Model API credentials (canonical official variable: MODEL_API_KEY)
MODEL_API_KEY=your_key_here
META_BASE_URL=https://api.meta.ai/v1

# Model Identifiers
MUSE_IMAGE_MODEL=muse-image-1.0
MUSE_SPARK_MODEL=muse-spark-1.3
SAM_MODEL=sam-3.1

# Safety & Budget Caps
GLOBAL_SPEND_CAP_USD=25.0
MAX_RETRIES_PER_PANEL=2
MAX_CONCURRENT_REQUESTS=2
